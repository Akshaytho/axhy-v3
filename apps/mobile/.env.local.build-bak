# Local mobile dev — points Expo Go on a real iPhone at the Mac's LAN IP.
# Update this when your Mac's LAN IP changes (different WiFi network etc).
# To find current IP: `ipconfig getifaddr en0`
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.6:4000

# F-006a — OneSignal sandbox App ID for local smoke testing.
# This file is gitignored at the repo root (.gitignore `.env.local` rule).
# For EAS Build (staging/prod), set EXPO_PUBLIC_ONESIGNAL_APP_ID in the
# EAS Build profile env, NOT here.
#
# Disabled in Expo Go (2026-05-17 PM): react-native-onesignal needs a
# native binary that ships with EAS dev/prod builds. Expo Go can't load
# the TurboModule, throws an Invariant Violation at import-time. Leaving
# this commented forces shouldCallOneSignal() -> false and the auth path
# proceeds without push identity linking. Restore the line below when
# testing against an EAS dev build.
# EXPO_PUBLIC_ONESIGNAL_APP_ID=os_v2_app_gc72d7xe5fb3xo3k7ti5ddlvoufsssfo7xoempetpm2ohwab3322vga2c5ydllkrhwp7dxqfpwdg74jrguqiqoc7ltllgmnjfxy4u3a
