{
  "expo": {
    "name": "Axhy",
    "slug": "axhy",
    "scheme": "axhy",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "android", "web"],
    "web": {
      "bundler": "metro"
    },
    "ios": {
      "bundleIdentifier": "app.axhy.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "app.axhy.mobile"
    },
    "plugins": ["expo-localization", "expo-router", "expo-secure-store"]
  }
}
