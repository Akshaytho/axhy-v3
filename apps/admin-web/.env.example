# apps/admin-web/.env.example
# Copy to apps/admin-web/.env.local; .env.local is gitignored.
# @derives(ADR-0005)

# Backend API URL — used by /login client-side fetch (Phase B work)
NEXT_PUBLIC_AXHY_API_URL=http://localhost:4000

# WhatsApp number (E.164 without leading +) used by all WhatsApp CTAs.
# Replace placeholder before launch.
NEXT_PUBLIC_AXHY_WHATSAPP=919999999999

# PostHog analytics (optional, EU region for DPDP)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Server-only JWT secret. MUST match backend JWT_SECRET exactly.
# Required in production (≥32 chars). In dev, missing → warning + placeholder.
# NEVER prefix with NEXT_PUBLIC_ — this must NOT leak to the client bundle.
# [ORCHESTRATOR_EXCEPTION] sub-agent HR A1 task 9
JWT_SECRET=replace-with-backend-jwt-secret-min-32-chars-long
