# apps/backend/.env.example
# Copy to apps/backend/.env.local and fill in. .env.local is gitignored.
#
# Rotation policy: see docs/runbooks/secret-rotation.md (lands Day 6).

# ─── Database ─────────────────────────────────────────────────────────────────
# How rotated: Railway dashboard → Postgres service → Variables → regenerate
DATABASE_URL=postgresql://USER:PASS@HOST:PORT/DB
DATABASE_URL_SUPER=postgresql://SUPER_USER:SUPER_PASS@HOST:PORT/DB

# ─── Auth ─────────────────────────────────────────────────────────────────────
# How rotated: regenerate JWT_SECRET; force re-login for all users
JWT_SECRET=change-me-32-bytes-base64
JWT_ACCESS_TTL_SECONDS=900           # 15 min
JWT_REFRESH_TTL_SECONDS=2592000      # 30 days

# ─── SMS / OTP (MSG91) ────────────────────────────────────────────────────────
# How rotated: MSG91 dashboard → API Keys → revoke + reissue; update Railway env
MSG91_API_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Dev-only OTP bypass. When set to "1":
#   - sendOtpSms() is a no-op (no real SMS, no MSG91 charge)
#   - verifyOtp() accepts the magic code "123456" for any phone
#   - the real DB-stored code also still works (existing E2E tests keep passing)
# UNSET this in any environment that handles real users.
AXHY_OTP_BYPASS=1

# ─── WhatsApp (Gupshup) ───────────────────────────────────────────────────────
# How rotated: Gupshup dashboard → API Keys; rotate every 90 days
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# How rotated: Resend dashboard → API Keys
RESEND_API_KEY=
RESEND_FROM=Axhy <hello@axhy.app>

# ─── AI providers ─────────────────────────────────────────────────────────────
# How rotated: provider dashboard → revoke + reissue; on rotation, also clear
# any cached prompts in the AI cost-tracking table
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=
COHERE_API_KEY=                       # for India-region customer-data embeddings

# ─── File storage (Cloudflare R2) ─────────────────────────────────────────────
# How rotated: Cloudflare dashboard → R2 → API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=axhy-uploads
R2_PUBLIC_BASE_URL=https://uploads.axhy.app

# ─── Observability ────────────────────────────────────────────────────────────
# How rotated: Sentry dashboard → Settings → Client Keys
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ─── Rate limits (per-tenant defaults) ────────────────────────────────────────
RATE_LIMIT_TENANT_REQUESTS_PER_MIN=100
RATE_LIMIT_USER_REQUESTS_PER_MIN=60

# ─── Feature flags ────────────────────────────────────────────────────────────
# Backend reads from `feature_flags` table; this is for emergency overrides
FEATURE_FLAGS_OVERRIDES=
