# apps/backend/.env.example
# Copy to apps/backend/.env.local and fill in. .env.local is gitignored.
#
# Rotation policy: see docs/runbooks/secret-rotation.md (lands Day 6).

# ─── Database ─────────────────────────────────────────────────────────────────
# How rotated: Railway dashboard → Postgres service → Variables → regenerate
DATABASE_URL=postgresql://USER:PASS@HOST:PORT/DB
DATABASE_URL_SUPER=postgresql://SUPER_USER:SUPER_PASS@HOST:PORT/DB

# ─── Auth ─────────────────────────────────────────────────────────────────────
# How rotated: regenerate JWT_SECRET; force re-login for all users
JWT_SECRET=change-me-32-bytes-base64
JWT_ACCESS_TTL_SECONDS=900           # 15 min
JWT_REFRESH_TTL_SECONDS=2592000      # 30 days

# ─── OTP delivery (Meta WhatsApp Cloud API) ───────────────────────────────────
# Channel pivoted from MSG91 SMS to WhatsApp 2026-05-25. Workers all carry
# smartphones with WhatsApp installed; WhatsApp removes the DLT-registration
# blocker. When TOKEN / PHONE_NUMBER_ID / TEMPLATE_NAME are all unset,
# sendOtpWhatsApp() is a no-op (dev / pilot mode) — the OTP is still issued
# into the Redis OTP store and tests read it from there directly.
#
# How rotated: developers.facebook.com → your App → WhatsApp → API Setup →
# regenerate temporary token (24h) OR create permanent System User token via
# Meta Business Settings → System Users → Generate New Token (no expiry).
#
# Test mode (pre-business-verification): Meta only delivers to phone numbers
# explicitly added in the WhatsApp dashboard under "To" → Manage recipient
# list. All other numbers fail with HTTP 400 from Meta which surfaces as
# 500 OTP_FAILED to the client.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=axhy_login_otp
WHATSAPP_OTP_TEMPLATE_LANG=en

# Production-safe operator OTP bypass. Comma-separated E.164 phone numbers
# allowed to authenticate with magic code "123456" instead of the real OTP.
# Strict allowlist — NOT a blanket bypass; non-listed phones see no change.
# Replaces the deleted AXHY_OTP_BYPASS=1 (which was a universal hole).
# Whitespace, parens, dashes are normalized so "+91 (9381) 378-257" matches
# "+919381378257" from the client. Safe to leave on permanently in
# production; operationally used by founder + test users.
# Example: +919381378257,+919999999999
AXHY_OTP_BYPASS_PHONES=

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# How rotated: Resend dashboard → API Keys
RESEND_API_KEY=
RESEND_FROM=Axhy <hello@axhy.app>

# ─── AI providers ─────────────────────────────────────────────────────────────
# How rotated: provider dashboard → revoke + reissue; on rotation, also clear
# any cached prompts in the AI cost-tracking table
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
SARVAM_API_KEY=
COHERE_API_KEY=                       # for India-region customer-data embeddings

# ─── File storage (Cloudflare R2) ─────────────────────────────────────────────
# How rotated: Cloudflare dashboard → R2 → API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=axhy-uploads
R2_PUBLIC_BASE_URL=https://uploads.axhy.app

# ─── Observability ────────────────────────────────────────────────────────────
# How rotated: Sentry dashboard → Settings → Client Keys
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# ─── Rate limits (per-tenant defaults) ────────────────────────────────────────
RATE_LIMIT_TENANT_REQUESTS_PER_MIN=100
RATE_LIMIT_USER_REQUESTS_PER_MIN=60

# ─── Feature flags ────────────────────────────────────────────────────────────
# Backend reads from `feature_flags` table; this is for emergency overrides
FEATURE_FLAGS_OVERRIDES=
