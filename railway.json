{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @axhy/$RAILWAY_SERVICE_NAME... build"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "pnpm --filter @axhy/$RAILWAY_SERVICE_NAME start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
