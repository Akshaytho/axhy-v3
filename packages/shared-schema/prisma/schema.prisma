// packages/shared-schema/prisma/schema.prisma
//
// Axhy v3 Prisma schema — single source of truth for the database.
//
// @derives(ADR-0003) — Single source of truth for schema
// @derives(ADR-0004) — Postgres on Railway
// @derives(panel-2026-05-08 — Phase B.1 foundation + B.2 domain tables)
//
// Day 3 scope: Company, User, Membership + Site, Worker, Visit, LeaveRequest.
// Phase B.1: AuditEvent + Outbox + Device + OtpAttempt (mirror).
// Phase B.2: Attendance + Complaint + SwapRequest + SupervisorDecision +
// SupervisorDailyContext + HRUpdate + VisitPhoto. Tier 1 routes use a
// subset; the rest are placeholders the connectedness map can already
// see + B.3+ commits can fill in callers without re-migrating.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["axhy"]
}

// ============================================================================
// Tenant
// ============================================================================

model Company {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  slug            String   @unique
  /// @personal owner contact phone (E.164)
  ownerPhone      String   @db.VarChar(16)
  /// @personal owner contact name
  ownerName       String
  status          String   @default("ACTIVE")
  /// daily AI spend counter in INR. Resets at UTC midnight via cron.
  /// NOT @personal — financial counter, not PII (Vinod DPDP scoping).
  /// @derives(spec-2 §9.1) @derives(ADR-0023)
  aiSpendDailyInr Decimal  @default(0) @db.Decimal(12, 4)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships            Membership[]
  users                  User[]
  sites                  Site[]
  workers                Worker[]
  visits                 Visit[]
  leaves                 LeaveRequest[]
  auditEvents            AuditEvent[]
  outbox                 Outbox[]
  devices                Device[]
  attendances            Attendance[]
  complaints             Complaint[]
  swapRequests           SwapRequest[]
  supervisorDecisions    SupervisorDecision[]
  livingDocs             LivingDoc[]
  hrUpdates              HRUpdate[]
  visitPhotos            VisitPhoto[]
  calendarEntries        CalendarEntry[]
  assignments            Assignment[]
  chatThreads            ChatThread[]
  chatMessages           ChatMessage[]
  // Layer 1 core primitives (2026-05-15)
  hrPods                 HRPod[]
  policies               Policy[]
  notifications          Notification[]
  digests                Digest[]
  // P1.5 SiteSupervisorBinding (2026-05-15)
  siteSupervisorBindings SiteSupervisorBinding[]
  // F28 ReplacementInvite (2026-05-18 — Wave 1 backend; ships with model
  // definition in the parallel Wave 1 subagent commit).
  replacementInvites     ReplacementInvite[]
  // Wave 3 complaint threading (2026-05-18)
  complaintMessages      ComplaintMessage[]
  // Sprint 1 deep-review Cluster G fix (2026-05-18) — ComplaintMessageRead
  // back-relation so a Company cascade-delete sweeps read-receipts too.
  complaintMessageReads  ComplaintMessageRead[]
  // Sprint 1 deep-review Cluster F fix (2026-05-18) — IdempotencyKey
  // back-relation. Cascade-delete prevents orphan cached responses.
  idempotencyKeys        IdempotencyKey[]

  @@schema("axhy")
}

// ============================================================================
// Identity (cross-company)
// ============================================================================

model User {
  id        String   @id @default(uuid()) @db.Uuid
  /// @personal phone is the primary login; E.164 format
  phone     String   @unique @db.VarChar(16)
  /// @personal full legal name
  name      String?
  /// @personal preferred locale
  locale    String   @default("en") @db.VarChar(8)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  Company     Company?     @relation(fields: [companyId], references: [id])
  companyId   String?      @db.Uuid

  workerProfile      Worker?
  devices            Device[]
  // P1.5 SiteSupervisorBinding back-relations (2026-05-15)
  supervisorBindings SiteSupervisorBinding[] @relation("BindingSupervisor")
  actingForBindings  SiteSupervisorBinding[] @relation("BindingActingFor")
  // F28 ReplacementInvite back-relations (2026-05-18 — Wave 1 backend)
  sentReplacementInvites     ReplacementInvite[] @relation("ReplacementInviteFromSupervisor")
  receivedReplacementInvites ReplacementInvite[] @relation("ReplacementInviteToWorker")
  // F-006b 2026-05-21 — DPDP one-page consent. Append-only.
  consentLogs                ConsentLog[]

  @@index([companyId])
  @@schema("axhy")
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  userId    String   @db.Uuid
  role      String
  status    String   @default("ACTIVE")
  /// HR pod assignment (per workflow-design-closure §4). Only meaningful when
  /// role = HR. NULL for all other roles. Layer 1 schema-only; Layer 2 wires
  /// the queue partitioning + fallback semantics.
  /// @derives(workflow-design-closure §4)
  podId     String?  @db.Uuid
  /// Monthly salary in paise (₹1 = 100 paise). 0 for unpaid roles
  /// (SUPER_ADMIN, optional COMPANY_ADMIN). Every paid role lives here.
  /// @derives(ADR-0025)
  baseSalaryPaise Int @default(0)
  /// @personal bank IFSC for payroll transfer.
  /// @derives(ADR-0025)
  bankIfsc  String?  @db.VarChar(16)
  /// @personal bank account number for payroll transfer.
  /// @derives(ADR-0025)
  bankAcct  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  hrPod   HRPod?  @relation(fields: [podId], references: [id], onDelete: SetNull)

  @@unique([companyId, userId, role])
  @@index([companyId])
  @@index([userId])
  @@index([companyId, podId])
  @@schema("axhy")
}

// ============================================================================
// Operational
// ============================================================================

model Site {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  name      String
  /// @personal optional site address
  address   String?
  /// nullable if site is not yet geocoded
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  /// 14-state SiteState machine (placeholder string until state-machines wires it)
  state     String   @default("DRAFT")
  /// per-site weekly day-pattern override (default = 6-day week)
  workdays  String   @default("MTWTFS") @db.VarChar(7)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  visits      Visit[]
  complaints  Complaint[]
  swaps       SwapRequest[]
  assignments Assignment[]
  // P1.5 SiteSupervisorBinding (2026-05-15)
  bindings    SiteSupervisorBinding[]
  // F28 ReplacementInvite (2026-05-18 — Wave 1 backend)
  replacementInvites ReplacementInvite[]

  @@index([companyId])
  @@index([companyId, state])
  @@schema("axhy")
}

model Worker {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  /// optional User link — workers may exist before they get phone access
  userId            String?  @unique @db.Uuid
  /// @personal worker name as displayed
  name              String
  /// @personal worker phone (E.164)
  phone             String   @db.VarChar(16)
  /// 15-state WorkerState machine (see @axhy/state-machines)
  state             String   @default("INVITED")
  /// Worker's preferred notification language (ISO 639-1: hi / te / en / bn / ta / ...).
  /// Default 'hi'; tenant-configurable per workflow-design-closure §5.1 + Decision 4
  /// + Policy `worker.preferred_language_default`.
  /// @derives(workflow-design-closure §5.1, Decision 4)
  preferredLanguage String   @default("hi") @db.VarChar(8)
  joinedAt          DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User?          @relation(fields: [userId], references: [id])
  visits      Visit[]
  leaves      LeaveRequest[]
  attendances Attendance[]
  fromSwaps   SwapRequest[]  @relation("SwapFromWorker")
  toSwaps     SwapRequest[]  @relation("SwapToWorker")
  assignments Assignment[]

  @@unique([companyId, phone])
  @@index([companyId])
  @@index([companyId, state])
  @@schema("axhy")
}

model Visit {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @db.Uuid
  workerId          String    @db.Uuid
  siteId            String    @db.Uuid
  /// 12-state VisitState v1.1 machine
  state             String    @default("SCHEDULED")
  scheduledFor      DateTime
  startedAt         DateTime?
  completedAt       DateTime?
  /// 0-16; soft cap on photo count per master plan §G
  photosBefore      Int       @default(0)
  photosAfter       Int       @default(0)
  /// optional voice note ref (S3/R2 key); voice file deleted within 24h after STT
  voiceKey          String?
  /// AI verification text (1-2KB, stored after AI verification surface fires)
  verificationText  String?
  /// AI verification model used (per ADR-0023)
  verificationModel String?
  /// flagged-for-supervisor-review bit
  flagged           Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  /// FK to Visit being corrected — null on canonical (uncorrected) row
  correctsVisitId  String? @db.Uuid
  /// self-pointer to root of correction chain — equals own id on root rows
  originalVisitId  String? @db.Uuid
  /// 'wrong-site' | 'wrong-time' | 'duplicate' | 'wrong-worker' | 'other'
  correctionReason String?
  correctionNote   String?

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker  Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  site    Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  photos  VisitPhoto[]
  // F28 ReplacementInvite (2026-05-18 — Wave 1 backend; visit may be the cover target)
  replacementInvites ReplacementInvite[]

  @@index([companyId, scheduledFor])
  @@index([companyId, state])
  @@index([workerId, scheduledFor])
  @@index([siteId, scheduledFor])
  @@index([companyId, flagged], map: "visit_flagged_idx")
  @@schema("axhy")
}

model CalendarEntry {
  id                       String    @id @default(uuid()) @db.Uuid
  companyId                String    @db.Uuid
  /// User.id of the supervisor (composite-keyed with companyId; NOT Membership.id).
  /// See feedback_supervisor_id_is_user_id.md (panel-locked 2026-05-10).
  supervisorId             String    @db.Uuid
  date                     DateTime  @db.Date
  /// 'NOTE' | 'DEMAND' | 'TENTATIVE_ASSIGNMENT' | 'EVENT'
  kind                     String
  /// kind-specific structured fields validated at app layer (Zod)
  payload                  Json      @default("{}")
  /// @personal — free-form text (PII-bearing, scrubbed on supervisor erasure)
  notes                    String?
  /// computed: min(createdAt + 30d, promotedAt) — stored for query speed
  editableUntil            DateTime
  /// 'ASSIGNMENT' | 'SITE_SHIFT_REQ' | 'CHANGE_REQUEST' | null
  promotedToKind           String?
  promotedToId             String?   @db.Uuid
  promotedAt               DateTime?
  /// Wave 1: stored when promoted to Assignment; Wave 2 hydrates real Assignment row from this.
  pendingAssignmentPayload Json?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, supervisorId, date])
  @@index([companyId, date])
  @@schema("axhy")
}

model Assignment {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  workerId         String    @db.Uuid
  siteId           String    @db.Uuid
  /// "HH:mm" format
  shiftStart       String
  shiftEnd         String
  /// 7-char Mon-Sun mask: "MTWTFS_" = Mon-Sat, "_______" = none
  dayMask          String
  validFrom        DateTime  @db.Date
  /// null = open-ended (per Q1 lock)
  validUntil       DateTime? @db.Date
  /// 3 states: DRAFT | ACTIVE | TERMINATED (per Q2 lock)
  state            String    @default("DRAFT")
  terminatedReason String?
  /// FK Membership — supervisor who terminated
  terminatedBy     String?   @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([companyId, state])
  @@index([workerId, state])
  @@index([siteId, state])
  @@schema("axhy")
}

/// ChatThread — per-supervisor conversation context with the AI. Each
/// supervisor may have up to 3 ACTIVE threads (archivedAt IS NULL) per
/// the docs/locked/security-gaps-to-fix.md GAP 8 fix. App-layer count
/// enforcement lives in apps/backend/src/lib/chat-thread-service.ts;
/// see migration 014_chat_thread_three_window for the constraint shape.
///
/// Indexes live in migration 014 only — Prisma's @@index cannot express
/// the `WHERE archivedAt IS NULL` partial-index needed for cheap
/// active-only lookups, so all ChatThread indexing is SQL-managed.
///
/// @derives(docs/locked/security-gaps-to-fix.md GAP 8)
/// @derives(docs/locked/chat-sidebar-context-flow.md)
model ChatThread {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  /// User.id of the supervisor (composite-keyed with companyId; NOT Membership.id).
  /// See feedback_supervisor_id_is_user_id.md (panel-locked 2026-05-10).
  supervisorId  String    @db.Uuid
  createdAt     DateTime  @default(now())
  lastMessageAt DateTime?
  /// Null = active. Non-null = archived; supervisor can still read but new
  /// messages do not append here.
  archivedAt    DateTime?

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@schema("axhy")
}

model ChatMessage {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  threadId        String   @db.Uuid
  /// 'user' | 'assistant' | 'system'
  role            String
  /// @personal supervisor's voice transcript or typed text
  transcript      String?
  /// @personal AI's response text
  aiResponseText  String?
  /// JSON array of { toolName, toolCallId, input, output? }
  toolCalls       Json?
  /// DecisionCardData per Spec 1 §9.5
  decisionCard    Json?
  /// 'HIGH'|'MEDIUM'|'LOW' from Sarvam
  voiceConfidence String?
  /// 'claude-sonnet-4-6' etc
  modelUsed       String?
  /// Computed cost in INR
  costInr         Decimal?
  /// OpenAI prompt_tokens_details.cached_tokens captured per call.
  /// Null when response didn't include the field (older SDK responses);
  /// used by ai_cost_daily view for cache-hit ratio.
  /// @derives(spec-2 §8.3)
  cacheTokens     Int?
  /// Raw OpenAI `response.usage.prompt_tokens` (input tokens, including
  /// cached prefix). Used by the per-supervisor daily TOKEN cap
  /// (supervisor-token-cap.ts) — supersedes the message-count cap.
  /// Nullable so existing rows pre-migration-015 don't need backfill.
  tokensIn        Int?
  /// Raw OpenAI `response.usage.completion_tokens` (output tokens).
  /// Counts toward the same supervisor daily cap.
  tokensOut       Int?
  /// Idempotency-Key from request
  idempotencyKey  String?
  createdAt       DateTime @default(now())

  thread  ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, threadId, createdAt])
  @@schema("axhy")
}

/// Generic HTTP idempotency cache — Sprint 1 deep-review Cluster F fix
/// (2026-05-18). Cached response by (companyId, routeKey, idempotencyKey)
/// so a state-changing POST that's retried within the 10-minute TTL
/// returns the same response without re-running the handler. Mirrors
/// `ChatRequestLog`'s shape; the delta is `routeKey` so one table
/// serves every route that opts in via the `withIdempotency` helper.
///
/// @derives(2026-05-18-sprint-1-deep-review.md Cluster F)
/// @derives(feedback_production_grade_workflow_rules.md — P8 retries/double-taps)
model IdempotencyKey {
  companyId      String   @db.Uuid
  /// e.g. "POST:/supervisor/replacement-invites"
  routeKey       String
  /// Client-supplied UUID from the Idempotency-Key header.
  idempotencyKey String
  /// HTTP status code of the cached response.
  responseStatus Int
  /// Full JSON response body the client saw on the first call.
  responseJson   Json
  createdAt      DateTime @default(now())
  /// createdAt + 10 minutes
  expiresAt      DateTime

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, routeKey, idempotencyKey])
  @@index([expiresAt])
  @@schema("axhy")
}

model ChatRequestLog {
  companyId      String   @db.Uuid
  /// Client-generated UUID; same key = same response
  idempotencyKey String
  /// Cached final response shape (full JSON returned to client)
  responseJson   Json
  /// FK to message row created on first call
  chatMessageId  String?  @db.Uuid
  createdAt      DateTime @default(now())
  /// createdAt + 24h
  expiresAt      DateTime

  @@id([companyId, idempotencyKey])
  @@index([expiresAt])
  @@schema("axhy")
}

model LeaveRequest {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  workerId     String    @db.Uuid
  fromDate     DateTime  @db.Date
  toDate       DateTime  @db.Date
  reason       String
  /// 12-state LeaveRequestState machine (placeholder)
  state        String    @default("REQUESTED")
  decidedBy    String?   @db.Uuid
  decidedAt    DateTime?
  /// @personal optional supervisor note
  decisionNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([companyId, state])
  @@index([workerId])
  @@index([companyId, fromDate])
  @@schema("axhy")
}

// ============================================================================
// Foundation (Phase B.1) — audit trail, side-effect queue, device registry
// ============================================================================

/// System-of-record audit. Every state transition + supervisor/HR decision
/// writes one immutable row here. Per data-flow §4 — this is the source of
/// truth the panel + the connectedness map's audit-event nodes mirror.
///
/// @derives(master-plan §L) — bug-prevention discipline (every transition
/// auditable)
/// @derives(panel-2026-05-08) — phase B.1 foundation lock
model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  /// stable kind string from a known taxonomy (WORKER_MARKED_ABSENT,
  /// LEAVE_APPROVED, SITE_COMPLAINT_LOGGED, ...). Not an enum so the
  /// taxonomy can grow without schema migrations.
  kind      String
  /// UUID of the user who took the action (supervisor / HR / owner /
  /// system). Not a FK — actor may be deleted while audit must persist.
  actorId   String   @db.Uuid
  /// flexible target ref (worker / site / swap / visit / leave_request).
  /// String not Uuid because some targets are composite or string keys.
  targetId  String?
  /// structured payload — diff, prior-state, decision-tier, anything the
  /// row's `kind` taxonomy specifies. JSON for forward-compat.
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, kind])
  @@index([companyId, createdAt])
  @@index([actorId])
  @@schema("axhy")
}

/// Atomic side-effect queue. Every domain write that triggers an external
/// effect (Gupshup SMS, payroll recompute, AI verification, email)
/// enqueues one row here inside the same transaction as the domain write.
/// A separate dispatcher process (Phase B.6) drains this with retry +
/// exponential backoff. Per data-flow §4 — outbox pattern, atomic.
///
/// @derives(master-plan §L) — cascade depth ≤ 3 enforced in dispatcher
/// @derives(ADR-0009) — outbox over Redis until measured pain
/// @derives(panel-2026-05-08) — phase B.1 foundation lock
model Outbox {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @db.Uuid
  /// dotted topic name (gupshup.send, payroll.recompute, ai.verify, ...)
  topic          String
  /// payload the dispatcher hands to the topic's handler
  payload        Json      @default("{}")
  /// nullable until processed. Idempotent re-tries only run when
  /// processedAt is null AND nextRetryAt is in the past.
  processedAt    DateTime?
  /// retry counter; >= 5 → quarantined (handler stops retrying)
  failCount      Int       @default(0)
  /// next time the dispatcher should attempt this row (for backoff)
  nextRetryAt    DateTime  @default(now())
  /// last error message, for ops triage
  lastError      String?
  /// idempotency key for at-most-once enqueue (e.g. "${companyId}:budget_WARN:20260510").
  /// Partial unique index on (companyId, idempotencyKey) WHERE idempotencyKey IS NOT NULL
  /// enforces dedup at DB layer; existing rows with NULL key coexist freely.
  /// @derives(spec-2 §9.4) @derives(ADR-0009)
  idempotencyKey String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, idempotencyKey])
  @@index([companyId])
  @@index([processedAt, nextRetryAt])
  @@index([topic])
  @@schema("axhy")
}

/// OTP attempts table — backs the OTP-login flow. Schema mirrors the raw
/// SQL table created in `apps/backend/src/lib/otp-store.ts::ensureSchema`.
/// Modeled in Prisma SOLELY so the schema-driven migration doesn't drop
/// the unmanaged table on every diff. Reads + writes still go through
/// raw SQL in otp-store.ts (panel-locked — login path is too perf-
/// sensitive to round-trip through Prisma's transaction layer).
///
/// Compound PK (phone, issuedAt) matches the raw-SQL shape exactly.
///
/// @derives(ADR-0007) — phone-OTP login
/// @derives(panel-2026-05-08) — leave OTP read/write in raw SQL; schema
///   only mirrors the table shape so migrations stay clean
model OtpAttempt {
  /// @personal phone (E.164)
  phone     String   @db.VarChar(16)
  codeHash  String   @map("code_hash")
  issuedAt  DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  consumed  Boolean  @default(false)

  @@id([phone, issuedAt])
  @@index([phone, issuedAt(sort: Desc)], map: "otp_phone_recent_idx")
  @@map("otp_attempts")
  @@schema("axhy")
}

/// Registered phone with a 10-state DeviceState machine (UNREGISTERED →
/// REGISTERED → TRUSTED → REVOKED ...). Per data-flow §4 + §5 — used for
/// per-device session tracking, login rate-limiting, revocation.
///
/// One row per (user, company, phone). A user with two phones in one
/// company has two Device rows; a supervisor with memberships in two
/// companies has two Device rows even with the same phone.
///
/// @derives(panel-2026-05-08) — phase B.1 foundation lock
model Device {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @db.Uuid
  userId     String    @db.Uuid
  /// 10-state DeviceState machine (default REGISTERED on first OTP login;
  /// progresses to TRUSTED after explicit founder/HR approval).
  state      String    @default("REGISTERED")
  /// @personal phone model (e.g. "iPhone 14", "Redmi Note 12")
  phoneModel String?
  /// @personal OS version
  osVersion  String?
  /// @personal app version (vX.Y.Z) — for forced-upgrade flow
  appVersion String?
  /// @personal last time the device made an authenticated request
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([companyId, state])
  @@schema("axhy")
}

// ============================================================================
// Domain (Phase B.2) — supervisor / HR action targets
// ============================================================================

/// Daily attendance fact: one row per (worker × date) with a status
/// (PRESENT, ABSENT_NO_CALL, ABSENT_APPROVED_LEAVE, HALF_DAY, ON_BREAK).
/// Written by supervisor's "Mark worker absent" action (B.3) and by the
/// auto-clock-in flow when a Visit transitions STARTED. Used by the
/// payroll computation pipeline (B.6 outbox topic `payroll.recompute`).
///
/// @derives(data-flow §5 — supervisor "Mark worker absent" action)
/// @derives(panel-2026-05-08) — Phase B.2 domain table
model Attendance {
  id                   String   @id @default(uuid()) @db.Uuid
  companyId            String   @db.Uuid
  workerId             String   @db.Uuid
  date                 DateTime @db.Date
  /// PRESENT | ABSENT_NO_CALL | ABSENT_APPROVED_LEAVE | HALF_DAY | ON_BREAK
  status               String
  /// UUID of the supervisor who marked. Not a FK — actor may be deleted
  /// while the attendance fact must persist (DPDP archive).
  markedBySupervisorId String   @db.Uuid
  /// optional free-text reason from supervisor / voice transcription
  reason               String?
  /// pay deduction in paise (0 for PRESENT; e.g. 50000 = ₹500 for full
  /// absence). Computed by payroll worker, may be 0 here on initial
  /// insert and updated later.
  payDeductPaise       Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, date])
  @@index([companyId])
  @@index([companyId, date])
  @@index([companyId, status])
  @@schema("axhy")
}

/// Site-level complaint logged by supervisor. NOTE-tier decision per
/// data-flow §5. If a site has 3+ open complaints in 24h, dispatcher
/// fires `hr.complaint_persisted` outbox topic and SiteState transitions
/// to FLAGGED.
///
/// @derives(data-flow §5 — log site complaint NOTE tier)
/// @derives(panel-2026-05-08) — Phase B.2 domain table
model Complaint {
  id                    String    @id @default(uuid()) @db.Uuid
  companyId             String    @db.Uuid
  siteId                String    @db.Uuid
  /// User.id of the supervisor who logged the complaint (composite-keyed
  /// with companyId; NOT Membership.id). See feedback_supervisor_id_is_user_id.md.
  supervisorId          String    @db.Uuid
  /// User.id of the supervisor who created the complaint via chat or the
  /// site complaint button. Equals supervisorId for now; kept as a distinct
  /// FK so chat-driven complaints attribute correctly under acting-supervisor
  /// windows where supervisorId is the bound supervisor but createdByUserId
  /// is the acting supervisor. Wave 3 chat intent classifier sets this from
  /// req.auth.userId at the moment of creation.
  createdByUserId       String    @db.Uuid
  /// short complaint text — supervisor's words via voice or button flow.
  /// Mirrored as the body of the initial ComplaintMessage row so the thread
  /// view doesn't need a UNION with the parent row.
  text                  String
  /// LOW | MEDIUM | HIGH (NOTE-tier severity)
  severity              String    @default("LOW")
  /// Complaint kind enum — drives mobile filtering, HR triage queues, and
  /// scenario reporting. One of: photo_mismatch | missed_area | attitude |
  /// theft_accusation | hygiene | noise | damage | gate_pass | other.
  /// Defaults to 'other' for back-compat with pre-Wave-3 rows; DB-level
  /// CHECK constraint enforces the enum (see migration 009).
  /// @derives(supervisor-30day-scenarios.md scenarios #26–38)
  kind                  String    @default("other")
  /// Complaint lifecycle state — OPEN | IN_HR | RESOLVED | DISMISSED.
  /// Replaces the pre-Wave-3 `resolvedAt IS NULL` proxy for "is it open?".
  /// `resolvedAt` is kept as the timestamp; `state` is the discrete machine.
  /// DB-level CHECK enforces the enum (see migration 009).
  state                 String    @default("OPEN")
  /// Count of HR-authored ComplaintMessage rows the supervisor has not yet
  /// marked read. Atomically incremented inside the same tx that creates
  /// the ComplaintMessage; decremented inside the read-receipt tx.
  /// Used by the drawer Complaints badge — counter on parent beats COUNT(*)
  /// (Zendesk pattern, per supervisor-drawer-and-decisions-redesign.md §D).
  unreadHrRepliesCount  Int       @default(0)
  /// Last reply timestamp (any author) — drives "Recent" sort + the
  /// drawer sub-line "HR replied 2h ago". Nullable until the first reply
  /// after the initial supervisor message.
  lastReplyAt           DateTime?
  /// nullable until the complaint is dismissed / resolved by HR/owner
  resolvedAt            DateTime?
  /// UUID of resolver (HR / owner / supervisor)
  resolvedBy            String?   @db.Uuid
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site     Site               @relation(fields: [siteId], references: [id], onDelete: Cascade)
  messages ComplaintMessage[]

  @@index([companyId])
  @@index([companyId, siteId])
  @@index([companyId, resolvedAt])
  // HR-side queries: "all open complaints across this tenant, newest first".
  @@index([companyId, state, createdAt])
  // Supervisor inbox: "complaints this supervisor logged, by state, newest first".
  @@index([companyId, createdByUserId, state, createdAt])
  @@schema("axhy")
}

/// Threaded reply on a Complaint. Created in three flows:
///   1. Wave-3 chat: `propose_log_complaint` creates the Complaint row PLUS
///      an initial ComplaintMessage row authored by the supervisor (so the
///      thread is non-empty from t=0; no UNION required to render).
///   2. Supervisor reply via `POST /complaints/:id/messages` from the
///      complaint thread chat surface.
///   3. HR reply via the same `POST /complaints/:id/messages` endpoint
///      (gated to HR-role JWT once HR portal lands; out of scope this wave).
///
/// Per-actor unread tracking lives in two places:
///   * `Complaint.unreadHrRepliesCount` — fast badge count for supervisor.
///   * `ComplaintMessageRead` — per-(message, actor) read receipts so we
///     can show a per-message "seen" indicator in v3.1 mobile and so
///     idempotent read-receipts work when the same actor marks the same
///     message read from two devices simultaneously (race test).
///
/// @derives(supervisor-drawer-and-decisions-redesign.md §C — Chat-to-Complaint)
/// @derives(panel-2026-05-18) — Wave 3 backend
model ComplaintMessage {
  id           String   @id @default(uuid()) @db.Uuid
  complaintId  String   @db.Uuid
  /// Tenant denormalized for cross-tenant isolation in RLS + indexed reads.
  /// Always equals Complaint.companyId (enforced by application code +
  /// FK joins under withTenantContext).
  companyId    String   @db.Uuid
  /// User.id of the author. NOT Membership.id; SUPERVISOR or HR or ADMIN.
  authorUserId String   @db.Uuid
  /// SUPERVISOR | HR | ADMIN. Persisted on the row (rather than derived
  /// from Membership at read time) so historical role-at-time-of-write
  /// is preserved if the user's role changes later. DB-level CHECK
  /// enforces the enum (see migration 009).
  authorRole   String
  /// Message body text. Voice transcripts arrive here too (mobile
  /// transcribes first, then POSTs the text).
  body         String
  /// JSON array of attachments — `[{ type:'image', url, width, height }]`.
  /// Photos uploaded via the existing S3 signed-URL pipeline (mobile is
  /// responsible for the upload; backend stores the resulting URL). The
  /// Photo CDN slice is out of scope this wave; signed-URL fetch on read
  /// is the interim. Null when there are no attachments.
  attachments  Json?
  createdAt    DateTime @default(now())

  company   Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  complaint Complaint              @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  reads     ComplaintMessageRead[]

  // Thread render: load all messages for a complaint, oldest-first.
  @@index([complaintId, createdAt])
  // Tenant-scoped scans (e.g. HR portal "all new replies last 24h").
  @@index([companyId, createdAt])
  @@schema("axhy")
}

/// Per-(message, actor) read receipt. Composite primary key makes the
/// mark-read operation idempotent: two devices marking the same message
/// read simultaneously both succeed (one inserts, the other hits the PK
/// conflict and is silently treated as a no-op by an `upsert` or
/// `ON CONFLICT DO NOTHING` insert). Race-test mandated by Wave 3 brief.
///
/// `actorRole` is denormalized so HR-side badge math can filter
/// `actorRole='SUPERVISOR'` (i.e. "did the supervisor read it?") without
/// a join to Membership.
///
/// @derives(panel-2026-05-18) — Wave 3 backend race-test mitigation
model ComplaintMessageRead {
  messageId   String   @db.Uuid
  actorUserId String   @db.Uuid
  /// SUPERVISOR | HR | ADMIN at the time of read.
  actorRole   String
  /// Tenant denormalized so the (companyId, messageId) join under
  /// withTenantContext stays fast.
  companyId   String   @db.Uuid
  readAt      DateTime @default(now())

  message ComplaintMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  // Cluster G fix (P2, 2026-05-18): companyId FK back-relation. Without
  // it, a Company hard-delete would leave orphan rows with a dangling
  // companyId. RLS / withTenantContext still isolated correctly without
  // the FK, but defense-in-depth requires the DB-level cascade.
  // See `docs/findings/2026-05-18-sprint-1-deep-review.md` Cluster G.
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([messageId, actorUserId])
  @@index([companyId, actorUserId])
  @@schema("axhy")
}

/// Worker swap request — supervisor wants to move workerA off siteA in
/// favor of workerB at siteB (or reassign within the same site).
/// 12-state SwapRequestState machine: DRAFT → SENT → ACCEPTED |
/// DECLINED | EXPIRED → APPLIED | REVERSED.
///
/// OPERATIONAL-tier decision (no typed-words ack required).
///
/// @derives(data-flow §5 — swap worker OPERATIONAL tier)
/// @derives(panel-2026-05-08) — Phase B.2 domain table
model SwapRequest {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  /// User.id of the supervisor who initiated the swap (composite-keyed
  /// with companyId; NOT Membership.id). See feedback_supervisor_id_is_user_id.md.
  supervisorId String    @db.Uuid
  fromWorkerId String    @db.Uuid
  toWorkerId   String    @db.Uuid
  siteId       String    @db.Uuid
  /// 12-state SwapRequestState
  state        String    @default("DRAFT")
  /// when the swap takes effect
  effectiveAt  DateTime
  /// reason supervisor gave
  reason       String?
  /// nullable until accepted/declined by both workers (or the system)
  decidedAt    DateTime?
  appliedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromWorker Worker  @relation("SwapFromWorker", fields: [fromWorkerId], references: [id], onDelete: Cascade)
  toWorker   Worker  @relation("SwapToWorker", fields: [toWorkerId], references: [id], onDelete: Cascade)
  site       Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, state])
  @@index([siteId, effectiveAt])
  @@schema("axhy")
}

/// Supervisor decision proposed by AI chat (Phase C) before being
/// applied. Phase B Tier 1 routes write directly to the domain table
/// (Attendance, LeaveRequest, etc.) + AuditEvent without going through
/// SupervisorDecision. This table exists so the connectedness map can
/// see the planned Phase C entity, and so AI-extracted proposals have
/// a stable home when chat ships.
///
/// Decision tiers per data-flow §5:
///   - NOTE: auto-stored quietly, no UX
///   - OPERATIONAL: informational, supervisor confirms in passing
///   - PERSONNEL: warm/important, single-tap confirm
///   - EMPLOYMENT: danger/irreversible, typed-words ack required
///
/// @derives(data-flow §5 — supervisor decision tiers)
/// @derives(panel-2026-05-08) — Phase B.2 placeholder for Phase C AI
model SupervisorDecision {
  id                    String    @id @default(uuid()) @db.Uuid
  companyId             String    @db.Uuid
  /// User.id of the supervisor who made the decision (composite-keyed
  /// with companyId; NOT Membership.id). See feedback_supervisor_id_is_user_id.md.
  supervisorId          String    @db.Uuid
  /// MARK_ABSENT | APPROVE_LEAVE | LOG_COMPLAINT | SWAP_WORKER | ...
  kind                  String
  /// NOTE | OPERATIONAL | PERSONNEL | EMPLOYMENT
  tier                  String
  /// flexible target — worker / site / swap / leave_request / visit
  targetId              String?
  /// AI-extracted reasoning + entity refs + confidence
  payload               Json      @default("{}")
  /// nullable until supervisor confirms (or rejects)
  appliedAt             DateTime?
  /// EMPLOYMENT-tier requires explicit typed-words acknowledgment
  ackRequired           Boolean   @default(false)
  ackedAt               DateTime?
  /// Immutable JSON snapshot at row creation containing originator's chat excerpt
  /// + recent decisions about the worker + worker history + supervisor identity.
  /// Required at row-creation time for tier = EMPLOYMENT; optional for other tiers.
  /// Travels with the row across binding changes per workflow-design-closure Decision 7.
  /// @derives(workflow-design-closure §3.2, Decision 7)
  originContext         Json?
  /// Auto-set TRUE at row creation when the originating supervisor is currently
  /// inside an active acting-coverage absence window. Lets receiving acting cover +
  /// HR review render the "proposed during absence" framing.
  /// @derives(workflow-design-closure §3.2, Decision 7)
  proposedDuringAbsence Boolean   @default(false)
  /// Set when the currently-responsible supervisor explicitly rejects a PROPOSED
  /// decision via POST /decisions/:id/dismiss. Mutually exclusive with appliedAt:
  /// a row is in PROPOSED state iff both appliedAt IS NULL AND dismissedAt IS NULL.
  /// State ENUM column deferred per F-002 scope Q4=(b); discriminator is the
  /// pair (appliedAt, dismissedAt) for now.
  /// @derives(F-002 scope §3c)
  dismissedAt           DateTime?
  /// Plain-text reason the responsible supervisor gave at dismiss time.
  /// Surface in Activity tab + downstream learning for the AI extractor.
  /// @derives(F-002 scope §3c)
  dismissedReason       String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, supervisorId, createdAt])
  @@index([companyId, tier])
  @@index([companyId, appliedAt])
  @@index([companyId, dismissedAt])
  @@schema("axhy")
}

/// Supervisor's daily living-doc snapshot — personal rules, today's
/// worker status, today's sites, prior-day context. Loaded fresh at
/// 3:30 AM by the daily-prep worker (B.6+) and cached for the day's
/// Per-supervisor "living context" — the moat. Loaded into chat prompt as
/// Tier 2 cache slot; bumped on every confirmed propose_living_doc_update.
///
/// Renamed from `SupervisorDailyContext` in Wave 4b Phase 2 (2026-05-11) per
/// Spec 2 §3.5. Five JSON sections, each an array of LivingDocRule with
/// state ('PENDING'|'ACTIVE'|'REJECTED'|'EXPIRED'); only ACTIVE filtered
/// into prompt context this wave. PENDING/REJECTED used by Phase D nightly
/// nano-tier extractor.
///
/// @derives(spec-2 §3.5 — LivingDoc shape)
/// @derives(spec-2 §6 — extraction paths)
/// @derives(data-flow §8 — supervisor.context_load AI surface)
model LivingDoc {
  id                String   @id @default(uuid()) @db.Uuid
  companyId         String   @db.Uuid
  /// User.id of the supervisor whose living context this is (composite-keyed
  /// with companyId; NOT Membership.id). See feedback_supervisor_id_is_user_id.md.
  supervisorId      String   @db.Uuid
  /// JSON arrays of LivingDocRule per Spec 2 §3.5. Each rule:
  ///   { id, ruleText, description, visibility, scope, createdAt,
  ///     createdBy, state, decidedAt?, confidence?, source }
  /// Only state='ACTIVE' filtered into prompt context this wave.
  /// @derives(spec-2 §3.5)
  siteRules         Json     @default("[]")
  workerNotes       Json     @default("[]")
  clientPreferences Json     @default("[]")
  recurringTasks    Json     @default("[]")
  freeNotes         Json     @default("[]")
  /// Bumped on every successful propose_living_doc_update apply. Used as
  /// part of OpenAI prompt_cache_key so cache busts when rules change.
  /// @derives(spec-2 §8.2)
  version           Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, supervisorId])
  @@schema("axhy")
}

/// HR Update — HR creates these to push instructions to supervisors
/// (e.g. "new policy effective Monday, ack required"). Supervisor must
/// type a stable acknowledgment phrase to clear it. Per data-flow §5
/// (PERSONNEL/EMPLOYMENT tier — typed-words ack required).
///
/// @derives(data-flow §5 — HR update + typed-words ack)
/// @derives(panel-2026-05-08) — Phase B.2 placeholder for HR routes
model HRUpdate {
  id                     String    @id @default(uuid()) @db.Uuid
  companyId              String    @db.Uuid
  /// UUID of HR user who created the update
  hrId                   String    @db.Uuid
  /// POLICY_CHANGE | URGENT_NOTICE | PAYROLL_REMINDER | ...
  kind                   String
  /// the message body (rendered to supervisor as-is)
  content                String
  /// nullable for org-wide updates; UUID of specific supervisor when
  /// targeted
  targetSupervisorId     String?   @db.Uuid
  /// require explicit typed-words ack before clearing
  acknowledgmentRequired Boolean   @default(false)
  /// the exact phrase the supervisor must type (matched case-
  /// insensitive). Defaults to "I understand" if ack required.
  acknowledgmentPhrase   String?
  /// UUID of supervisor who acknowledged (only one per HRUpdate per
  /// supervisor; this captures most-recent ack)
  acknowledgedBy         String?   @db.Uuid
  acknowledgedAt         DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, targetSupervisorId])
  @@index([companyId, acknowledgedAt])
  @@schema("axhy")
}

/// Photo evidence per Visit. Each row tracks one R2 path + side
/// metadata (BEFORE/AFTER) + AI verification status. Visit.photosBefore
/// + Visit.photosAfter are denormalized counts for fast supervisor
/// reads; this table holds the row-level detail.
///
/// @derives(data-flow §5 — worker capture photos)
/// @derives(panel-2026-05-08) — Phase B.2 placeholder for photo upload
///   flow (real upload routes ship in B.5+)
model VisitPhoto {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @db.Uuid
  visitId        String   @db.Uuid
  /// BEFORE | AFTER
  side           String
  /// R2 object key (path within bucket, NOT full URL)
  r2Key          String
  /// optional perceptual hash for duplicate-photo detection
  pHash          String?
  /// AI verification status: PENDING | PASS | FLAGGED | NEEDS_REVIEW
  aiVerifyStatus String   @default("PENDING")
  /// short verification reasoning text from AI (1-2KB)
  aiVerifyText   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  visit   Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([visitId])
  @@index([companyId, aiVerifyStatus])
  @@schema("axhy")
}

// ============================================================================
// Layer 1 core primitives (2026-05-15) — workflow-design-closure §3 + §4
// ============================================================================

/// HR pod — operational partition for queue ownership and HR coordination.
/// Default operating target: ~200 workers + ~4 supervisors per pod (tunable per
/// tenant via Policy `hr.pod.target_worker_count` + `hr.pod.target_supervisor_count`).
/// Primary owner + backup owner per pod; cross-pod override allowed with audit.
///
/// Layer 1 schema-only. Queue partitioning + fallback semantics + lock UI ship
/// in Layer 2 (HR coordination layer).
///
/// @derives(workflow-design-closure §4 HR Pod Model)
/// @derives(workflow-design-closure Decision 1 — multi-HR coordination)
model HRPod {
  id                 String   @id @default(uuid()) @db.Uuid
  companyId          String   @db.Uuid
  name               String
  /// User.id of the HR user who routinely handles this pod's queue. All
  /// non-escalated queue items default to them.
  primaryOwnerUserId String   @db.Uuid
  /// User.id of the HR user who covers when primary is unavailable >24h
  /// (per closure Decision 2 tier 1). NULL = no backup configured yet.
  backupOwnerUserId  String?  @db.Uuid
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@index([companyId])
  @@index([companyId, primaryOwnerUserId])
  @@schema("axhy")
}

/// Per-tenant policy / config values. Append-only — current value for a key is
/// the most-recent row by setAt. Older rows preserved for audit / rollback.
///
/// Example keys: `hr.queue.urgent_sla_minutes`, `worker.preferred_language_default`,
/// `ai.backlog.chip_upgrade_seconds`, `hr.pod.target_worker_count`,
/// `worker.termination_appeal_days`, `notification.channel_fallback_chain`.
///
/// Layer 1 schema-only. PolicyService + defaults seed + admin-API for value
/// reads ship in Layer 2 (Stream C of kickoff memo §5).
///
/// @derives(workflow-design-closure §3.6 Policy primitive)
model Policy {
  id                    String   @id @default(uuid()) @db.Uuid
  companyId             String   @db.Uuid
  /// Dotted key — see closure §3.6 examples.
  key                   String
  /// Type-appropriate value. JSON for forward-compat (strings, numbers, arrays, objects).
  value                 Json
  /// User.id of the user who set this value.
  setBy                 String   @db.Uuid
  setAt                 DateTime @default(now())
  /// Snapshot of the previous value for this key for audit / rollback. NULL on first set.
  previousValueSnapshot Json?
  /// `sla` | `notification` | `worker` | `hr` | `ai` | `owner` | `handoff`.
  category              String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, key, setAt(sort: Desc)])
  @@index([companyId, category])
  @@schema("axhy")
}

/// Notification primitive — formalises outbox-driven push / SMS / WhatsApp-out /
/// email delivery with explicit per-row tracking (deliveredAt, failedAt, ackedAt).
/// Coalescing rules + channel fallback chain enforced by NotificationService
/// (Stream D, Layer 1).
///
/// Audience: exactly one of audienceUserId or audienceWorkerId set (workers may
/// not have a linked User).
///
/// @derives(workflow-design-closure §3.4 Notification primitive)
/// @derives(workflow-design-closure §7 Notification rules)
/// @derives(workflow-design-closure Decision 4 — worker supervisor-change notification)
model Notification {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  /// User.id of recipient (e.g. supervisor / HR / owner). Mutually exclusive with audienceWorkerId.
  audienceUserId   String?   @db.Uuid
  /// Worker.id of recipient (for workers without a linked User). Mutually exclusive with audienceUserId.
  audienceWorkerId String?   @db.Uuid
  /// `supervisor_change` | `termination_applied` | `leave_status` | `replacement_invite`
  /// | `flag_alert` | `hr_update` | `ai_budget_alert` | `binding_change` | ...
  kind             String
  /// `push` | `sms` | `whatsapp_out` | `email` | `in_app_banner`.
  channel          String
  /// `URGENT` | `NEXT_DAY` | `STANDARD` | `DIGEST` (closure Decision 3).
  priority         String    @default("STANDARD")
  /// Content + localisation context.
  payload          Json      @default("{}")
  scheduledAt      DateTime  @default(now())
  deliveredAt      DateTime?
  failedAt         DateTime?
  failureReason    String?
  ackedAt          DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, audienceUserId, deliveredAt(sort: Desc)])
  @@index([companyId, audienceWorkerId, deliveredAt(sort: Desc)])
  @@index([companyId, kind])
  @@index([companyId, scheduledAt])
  @@schema("axhy")
}

/// Auto-composed multi-event rollup, distinct from individual Notification rows.
/// Examples: owner monthly digest (closure Decision 10); supervisor
/// "while you were out" digest (closure §5.2.6); HR team daily digest.
///
/// Layer 1 ships the entity + stub composers in Stream E; real composers
/// land with their corresponding surfaces in Layers 3 + 4.
///
/// @derives(workflow-design-closure §3.5 Digest primitive)
model Digest {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  /// User.id of the digest recipient.
  audienceUserId  String    @db.Uuid
  /// `owner_monthly` | `owner_incident` | `owner_annual` | `hr_team_daily`
  /// | `supervisor_while_you_were_out`.
  kind            String
  /// Period start (inclusive). For owner_monthly: first of the month.
  periodStart     DateTime
  /// Period end (inclusive).
  periodEnd       DateTime
  composedAt      DateTime  @default(now())
  /// Structured content; per-kind schema validated at app layer.
  body            Json      @default("{}")
  /// Plain-text rendering for WhatsApp / SMS delivery.
  bodyText        String?
  /// `push` | `whatsapp_out` | `email` | `in_app`.
  deliveryChannel String?
  deliveredAt     DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, audienceUserId, composedAt(sort: Desc)])
  @@index([companyId, kind])
  @@schema("axhy")
}

/// Site responsibility binding — single table for both ACTING (temporary
/// coverage) and PERMANENT (portfolio assignment) bindings per supervisor
/// responsibility model §7 Option A.
///
/// Discriminator: `actingForUserId` IS NULL → permanent portfolio;
/// `actingForUserId` IS NOT NULL → temporary acting coverage.
///
/// effectiveUntil semantics:
///   - Acting (actingForUserId IS NOT NULL): effectiveUntil REQUIRED.
///   - Permanent (actingForUserId IS NULL): effectiveUntil OPTIONAL —
///     NULL for open-ended portfolio; non-NULL for a future-dated planned
///     switch (CHECK constraint enforces the acting-requires-until rule).
///
/// endedAt is reserved for manual early termination, supersession by a new
/// permanent binding, or correction bookkeeping — NOT for modelling a
/// planned future end (use effectiveUntil for that).
///
/// No-overlap invariant: at most one active binding of each kind per site
/// at any moment. Acting + permanent may stack (different kind values).
/// Enforced at DB level via Postgres EXCLUDE USING gist on
/// (siteId, kind-discriminator, tstzrange(effectiveFrom, COALESCE(effectiveUntil,
/// 'infinity'))) filtered by endedAt IS NULL. The discriminator is a CASE
/// over actingForUserId and is written into the migration SQL literally
/// (not via Prisma DSL) — see 20260516_p1_5_site_supervisor_binding.
///
/// @derives(workflow-design-closure §4 + §3.1 + §3.7)
/// @derives(supervisor-responsibility-model §7 Option A + §5.8 + §9 picks 5/6)
model SiteSupervisorBinding {
  id              String    @id @default(uuid()) @db.Uuid
  companyId       String    @db.Uuid
  siteId          String    @db.Uuid
  /// Supervisor responsible for this binding (User.id).
  userId          String    @db.Uuid
  /// NULL → permanent portfolio. NOT NULL → temporary acting coverage;
  /// references the original supervisor being covered for.
  actingForUserId String?   @db.Uuid
  effectiveFrom   DateTime  @db.Timestamptz(6)
  /// REQUIRED for acting; OPTIONAL for permanent (NULL = open-ended,
  /// non-NULL = planned future switch). DB CHECK enforces.
  effectiveUntil  DateTime? @db.Timestamptz(6)
  reason          String
  /// User.id of HR member who created the binding. Plain UUID (no FK) —
  /// audit-trail durability requires this row to survive User deletes.
  /// Follows the Attendance.markedBySupervisorId convention.
  createdBy       String    @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  /// Set on manual early termination / supersession / correction.
  /// Distinct from effectiveUntil (planned end).
  endedAt         DateTime? @db.Timestamptz(6)
  endedReason     String?
  /// Computed-on-write JSON snapshot of handoff context at binding creation.
  /// Composer logic lands in a later slice — column is nullable for now.
  /// @derives(workflow-design-closure §3.7)
  handoffPackage  Json?

  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site          Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  supervisor    User    @relation("BindingSupervisor", fields: [userId], references: [id], onDelete: Cascade)
  actingForUser User?   @relation("BindingActingFor", fields: [actingForUserId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([siteId, effectiveFrom(sort: Desc)])
  @@index([userId])
  @@schema("axhy")
}

/// F28 — ReplacementInvite (Wave 1 backend, 2026-05-18).
///
/// Single-recipient cover request. Supervisor sends ONE invite to ONE
/// worker; 2-minute TTL; on ACCEPTED / DECLINED / EXPIRED / CANCELLED the
/// supervisor may send a fresh invite to the same worker or a different
/// one. NOT a multi-worker broadcast — see
/// `feedback_replacement_invite_single_recipient.md` for why.
///
/// Lifecycle (enforced by service-layer conditional UPDATE +
/// DB CHECK constraint):
///   PENDING  -> ACCEPTED   (worker accepts within window)
///   PENDING  -> DECLINED   (worker explicitly declines)
///   PENDING  -> EXPIRED    (cron sweep, past expiresAt)
///   PENDING  -> CANCELLED  (supervisor recalls this invite)
/// All other transitions rejected at the service layer.
///
/// `expiresAt` defaults to sentAt + 120s; supervisor may pass
/// `expiresInSec` on create (30s–30min range).
/// The cron sweep flips PENDING -> EXPIRED past expiresAt + emits a
/// SupervisorDecision row of kind `REPLACEMENT_INVITE_OUTCOME` so the
/// outcome surfaces in the Decisions queue.
///
/// @derives(master-plan §P.4 — ReplacementInvite)
/// @derives(master-plan §G — supervisor surface)
/// @derives(replacement-invite-feature-spec.md, 2026-05-18)
/// @derives(supervisor-30day-scenarios.md scenarios #39–46 — swaps + emergency cover)
model ReplacementInvite {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @db.Uuid
  fromSupervisorId  String    @db.Uuid
  toWorkerId        String    @db.Uuid
  /// Visit this invite covers, when the supervisor is replacing for a
  /// specific visit. Nullable to support pre-shift open-slot invites.
  visitId           String?   @db.Uuid
  siteId            String    @db.Uuid
  scheduledStart    DateTime
  /// PENDING | ACCEPTED | DECLINED | EXPIRED | CANCELLED — DB CHECK enforced.
  status            String    @default("PENDING")
  sentAt            DateTime  @default(now())
  /// Default 120s after sentAt; supervisor may pass expiresInSec on create.
  expiresAt         DateTime
  respondedAt       DateTime?
  /// 'accept' | 'decline' | 'cron_expired' | 'supervisor_cancelled' |
  /// free-text reason on decline.
  respondReason     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company        Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromSupervisor User    @relation("ReplacementInviteFromSupervisor", fields: [fromSupervisorId], references: [id], onDelete: Cascade)
  toWorker       User    @relation("ReplacementInviteToWorker", fields: [toWorkerId], references: [id], onDelete: Cascade)
  site           Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)
  visit          Visit?  @relation(fields: [visitId], references: [id], onDelete: SetNull)

  /// Cron sweep predicate — PENDING rows past expiresAt; very hot in steady state.
  @@index([status, expiresAt])
  /// Supervisor inbox lookup — "show me my open / recent invites".
  @@index([companyId, fromSupervisorId, status])
  /// Worker inbox lookup — "show me my pending invites".
  @@index([companyId, toWorkerId, status])
  /// General list query — supervisor activity feed.
  @@index([companyId, sentAt])
  @@schema("axhy")
}

/// F-006b 2026-05-21 — DPDP consent log. Append-only audit row written on
/// first-run consent acceptance per MVP_V2_ALIGNED_PLAN.md §13 M22 (single-
/// page consent, replaces V2's 3-page carousel).
///
/// Cross-tenant: workers consent to the Axhy platform privacy policy, not
/// to the cleaning company. Hence no companyId column — userId only.
///
/// Append-only. Each call to POST /worker/consent inserts a new row. The
/// latest row by acceptedAt represents the current consent state. Older
/// rows preserved for DPDP forensics.
///
/// @derives(MVP_V2_ALIGNED_PLAN.md §6 + §13 M22)
/// @derives(F-006b worker-shell relaxation)
model ConsentLog {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @db.Uuid
  /// Version string of the policy at time of acceptance (e.g., "2026-05-21").
  policyVersion String   @db.VarChar(32)
  acceptedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, acceptedAt(sort: Desc)])
  @@schema("axhy")
}

