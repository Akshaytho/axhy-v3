// packages/shared-schema/prisma/schema.prisma
//
// Axhy v3 Prisma schema — single source of truth for the database.
//
// @derives(ADR-0003) — Single source of truth for schema
// @derives(ADR-0004) — Postgres on Railway
// @derives(panel-2026-05-08 — Phase B.1 foundation + B.2 domain tables)
//
// Day 3 scope: Company, User, Membership + Site, Worker, Visit, LeaveRequest.
// Phase B.1: AuditEvent + Outbox + Device + OtpAttempt (mirror).
// Phase B.2: Attendance + Complaint + SwapRequest + SupervisorDecision +
// SupervisorDailyContext + HRUpdate + VisitPhoto. Tier 1 routes use a
// subset; the rest are placeholders the connectedness map can already
// see + B.3+ commits can fill in callers without re-migrating.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["axhy"]
}

// ============================================================================
// Tenant
// ============================================================================

model Company {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  slug       String   @unique
  /// @personal owner contact phone (E.164)
  ownerPhone String   @db.VarChar(16)
  /// @personal owner contact name
  ownerName  String
  status     String   @default("ACTIVE")
  /// daily AI spend counter in INR. Resets at UTC midnight via cron.
  /// NOT @personal — financial counter, not PII (Vinod DPDP scoping).
  /// @derives(spec-2 §9.1) @derives(ADR-0023)
  aiSpendDailyInr Decimal @default(0) @db.Decimal(12, 4)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships             Membership[]
  users                   User[]
  sites                   Site[]
  workers                 Worker[]
  visits                  Visit[]
  leaves                  LeaveRequest[]
  auditEvents             AuditEvent[]
  outbox                  Outbox[]
  devices                 Device[]
  attendances             Attendance[]
  complaints              Complaint[]
  swapRequests            SwapRequest[]
  supervisorDecisions     SupervisorDecision[]
  livingDocs              LivingDoc[]
  hrUpdates               HRUpdate[]
  visitPhotos             VisitPhoto[]
  calendarEntries         CalendarEntry[]
  assignments             Assignment[]
  chatThreads             ChatThread[]
  chatMessages            ChatMessage[]

  @@schema("axhy")
}

// ============================================================================
// Identity (cross-company)
// ============================================================================

model User {
  id        String   @id @default(uuid()) @db.Uuid
  /// @personal phone is the primary login; E.164 format
  phone     String   @unique @db.VarChar(16)
  /// @personal full legal name
  name      String?
  /// @personal preferred locale
  locale    String   @default("en") @db.VarChar(8)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  Company     Company?     @relation(fields: [companyId], references: [id])
  companyId   String?      @db.Uuid

  workerProfile Worker?
  devices       Device[]

  @@index([companyId])
  @@schema("axhy")
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  userId    String   @db.Uuid
  role      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId, role])
  @@index([companyId])
  @@index([userId])
  @@schema("axhy")
}

// ============================================================================
// Operational
// ============================================================================

model Site {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  name      String
  /// @personal optional site address
  address   String?
  /// nullable if site is not yet geocoded
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  /// 14-state SiteState machine (placeholder string until state-machines wires it)
  state     String   @default("DRAFT")
  /// per-site weekly day-pattern override (default = 6-day week)
  workdays  String   @default("MTWTFS") @db.VarChar(7)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  visits      Visit[]
  complaints  Complaint[]
  swaps       SwapRequest[]
  assignments Assignment[]

  @@index([companyId])
  @@index([companyId, state])
  @@schema("axhy")
}

model Worker {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  /// optional User link — workers may exist before they get phone access
  userId          String?  @unique @db.Uuid
  /// @personal worker name as displayed
  name            String
  /// @personal worker phone (E.164)
  phone           String   @db.VarChar(16)
  /// @personal optional worker bank for salary
  bankIfsc        String?  @db.VarChar(16)
  /// @personal optional worker bank account
  bankAcct        String?
  /// 15-state WorkerState machine (see @axhy/state-machines)
  state           String   @default("INVITED")
  /// monthly salary in paise (₹1 = 100 paise)
  baseSalaryPaise Int      @default(0)
  joinedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company     Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        User?          @relation(fields: [userId], references: [id])
  visits      Visit[]
  leaves      LeaveRequest[]
  attendances Attendance[]
  fromSwaps   SwapRequest[]  @relation("SwapFromWorker")
  toSwaps     SwapRequest[]  @relation("SwapToWorker")
  assignments Assignment[]

  @@unique([companyId, phone])
  @@index([companyId])
  @@index([companyId, state])
  @@schema("axhy")
}

model Visit {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @db.Uuid
  workerId          String    @db.Uuid
  siteId            String    @db.Uuid
  /// 12-state VisitState v1.1 machine
  state             String    @default("SCHEDULED")
  scheduledFor      DateTime
  startedAt         DateTime?
  completedAt       DateTime?
  /// 0-16; soft cap on photo count per master plan §G
  photosBefore      Int       @default(0)
  photosAfter       Int       @default(0)
  /// optional voice note ref (S3/R2 key); voice file deleted within 24h after STT
  voiceKey          String?
  /// AI verification text (1-2KB, stored after AI verification surface fires)
  verificationText  String?
  /// AI verification model used (per ADR-0023)
  verificationModel String?
  /// flagged-for-supervisor-review bit
  flagged           Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  /// FK to Visit being corrected — null on canonical (uncorrected) row
  correctsVisitId   String?  @db.Uuid
  /// self-pointer to root of correction chain — equals own id on root rows
  originalVisitId   String?  @db.Uuid
  /// 'wrong-site' | 'wrong-time' | 'duplicate' | 'wrong-worker' | 'other'
  correctionReason  String?
  correctionNote    String?

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker  Worker       @relation(fields: [workerId], references: [id], onDelete: Cascade)
  site    Site         @relation(fields: [siteId], references: [id], onDelete: Cascade)
  photos  VisitPhoto[]

  @@index([companyId, scheduledFor])
  @@index([companyId, state])
  @@index([workerId, scheduledFor])
  @@index([siteId, scheduledFor])
  @@index([companyId, flagged], map: "visit_flagged_idx")
  @@schema("axhy")
}

model CalendarEntry {
  id             String    @id @default(uuid()) @db.Uuid
  companyId      String    @db.Uuid
  /// FK Membership — per-supervisor scope
  supervisorId   String    @db.Uuid
  date           DateTime  @db.Date
  /// 'NOTE' | 'DEMAND' | 'TENTATIVE_ASSIGNMENT' | 'EVENT'
  kind           String
  /// kind-specific structured fields validated at app layer (Zod)
  payload        Json      @default("{}")
  /// @personal — free-form text (PII-bearing, scrubbed on supervisor erasure)
  notes          String?
  /// computed: min(createdAt + 30d, promotedAt) — stored for query speed
  editableUntil  DateTime
  /// 'ASSIGNMENT' | 'SITE_SHIFT_REQ' | 'CHANGE_REQUEST' | null
  promotedToKind String?
  promotedToId   String?   @db.Uuid
  promotedAt     DateTime?
  /// Wave 1: stored when promoted to Assignment; Wave 2 hydrates real Assignment row from this.
  pendingAssignmentPayload Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, supervisorId, date])
  @@index([companyId, date])
  @@schema("axhy")
}

model Assignment {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @db.Uuid
  workerId         String    @db.Uuid
  siteId           String    @db.Uuid
  /// "HH:mm" format
  shiftStart       String
  shiftEnd         String
  /// 7-char Mon-Sun mask: "MTWTFS_" = Mon-Sat, "_______" = none
  dayMask          String
  validFrom        DateTime  @db.Date
  /// null = open-ended (per Q1 lock)
  validUntil       DateTime? @db.Date
  /// 3 states: DRAFT | ACTIVE | TERMINATED (per Q2 lock)
  state            String    @default("DRAFT")
  terminatedReason String?
  /// FK Membership — supervisor who terminated
  terminatedBy     String?   @db.Uuid
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([companyId, state])
  @@index([workerId, state])
  @@index([siteId, state])
  @@schema("axhy")
}

model ChatThread {
  id            String    @id @default(uuid()) @db.Uuid
  companyId     String    @db.Uuid
  /// FK Membership.id (per-supervisor)
  supervisorId  String    @db.Uuid
  createdAt     DateTime  @default(now())
  lastMessageAt DateTime?
  archivedAt    DateTime?

  company  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([companyId, supervisorId])
  @@schema("axhy")
}

model ChatMessage {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  threadId        String   @db.Uuid
  /// 'user' | 'assistant' | 'system'
  role            String
  /// @personal supervisor's voice transcript or typed text
  transcript      String?
  /// @personal AI's response text
  aiResponseText  String?
  /// JSON array of { toolName, toolCallId, input, output? }
  toolCalls       Json?
  /// DecisionCardData per Spec 1 §9.5
  decisionCard    Json?
  /// 'HIGH'|'MEDIUM'|'LOW' from Sarvam
  voiceConfidence String?
  /// 'claude-sonnet-4-6' etc
  modelUsed       String?
  /// Computed cost in INR
  costInr         Decimal?
  /// OpenAI prompt_tokens_details.cached_tokens captured per call.
  /// Null when response didn't include the field (older SDK responses);
  /// used by ai_cost_daily view for cache-hit ratio.
  /// @derives(spec-2 §8.3)
  cacheTokens     Int?
  /// Idempotency-Key from request
  idempotencyKey  String?
  createdAt       DateTime @default(now())

  thread  ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  company Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, threadId, createdAt])
  @@schema("axhy")
}

model ChatRequestLog {
  companyId      String   @db.Uuid
  /// Client-generated UUID; same key = same response
  idempotencyKey String
  /// Cached final response shape (full JSON returned to client)
  responseJson   Json
  /// FK to message row created on first call
  chatMessageId  String?  @db.Uuid
  createdAt      DateTime @default(now())
  /// createdAt + 24h
  expiresAt      DateTime

  @@id([companyId, idempotencyKey])
  @@index([expiresAt])
  @@schema("axhy")
}

model LeaveRequest {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  workerId     String    @db.Uuid
  fromDate     DateTime  @db.Date
  toDate       DateTime  @db.Date
  reason       String
  /// 12-state LeaveRequestState machine (placeholder)
  state        String    @default("REQUESTED")
  decidedBy    String?   @db.Uuid
  decidedAt    DateTime?
  /// @personal optional supervisor note
  decisionNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([companyId, state])
  @@index([workerId])
  @@index([companyId, fromDate])
  @@schema("axhy")
}

// ============================================================================
// Foundation (Phase B.1) — audit trail, side-effect queue, device registry
// ============================================================================

/// System-of-record audit. Every state transition + supervisor/HR decision
/// writes one immutable row here. Per data-flow §4 — this is the source of
/// truth the panel + the connectedness map's audit-event nodes mirror.
///
/// @derives(master-plan §L) — bug-prevention discipline (every transition
/// auditable)
/// @derives(panel-2026-05-08) — phase B.1 foundation lock
model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  /// stable kind string from a known taxonomy (WORKER_MARKED_ABSENT,
  /// LEAVE_APPROVED, SITE_COMPLAINT_LOGGED, ...). Not an enum so the
  /// taxonomy can grow without schema migrations.
  kind      String
  /// UUID of the user who took the action (supervisor / HR / owner /
  /// system). Not a FK — actor may be deleted while audit must persist.
  actorId   String   @db.Uuid
  /// flexible target ref (worker / site / swap / visit / leave_request).
  /// String not Uuid because some targets are composite or string keys.
  targetId  String?
  /// structured payload — diff, prior-state, decision-tier, anything the
  /// row's `kind` taxonomy specifies. JSON for forward-compat.
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, kind])
  @@index([companyId, createdAt])
  @@index([actorId])
  @@schema("axhy")
}

/// Atomic side-effect queue. Every domain write that triggers an external
/// effect (Gupshup SMS, payroll recompute, AI verification, email)
/// enqueues one row here inside the same transaction as the domain write.
/// A separate dispatcher process (Phase B.6) drains this with retry +
/// exponential backoff. Per data-flow §4 — outbox pattern, atomic.
///
/// @derives(master-plan §L) — cascade depth ≤ 3 enforced in dispatcher
/// @derives(ADR-0009) — outbox over Redis until measured pain
/// @derives(panel-2026-05-08) — phase B.1 foundation lock
model Outbox {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  /// dotted topic name (gupshup.send, payroll.recompute, ai.verify, ...)
  topic       String
  /// payload the dispatcher hands to the topic's handler
  payload     Json      @default("{}")
  /// nullable until processed. Idempotent re-tries only run when
  /// processedAt is null AND nextRetryAt is in the past.
  processedAt DateTime?
  /// retry counter; >= 5 → quarantined (handler stops retrying)
  failCount   Int       @default(0)
  /// next time the dispatcher should attempt this row (for backoff)
  nextRetryAt DateTime  @default(now())
  /// last error message, for ops triage
  lastError   String?
  /// idempotency key for at-most-once enqueue (e.g. "${companyId}:budget_WARN:20260510").
  /// Partial unique index on (companyId, idempotencyKey) WHERE idempotencyKey IS NOT NULL
  /// enforces dedup at DB layer; existing rows with NULL key coexist freely.
  /// @derives(spec-2 §9.4) @derives(ADR-0009)
  idempotencyKey String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, idempotencyKey])
  @@index([companyId])
  @@index([processedAt, nextRetryAt])
  @@index([topic])
  @@schema("axhy")
}

/// OTP attempts table — backs the OTP-login flow. Schema mirrors the raw
/// SQL table created in `apps/backend/src/lib/otp-store.ts::ensureSchema`.
/// Modeled in Prisma SOLELY so the schema-driven migration doesn't drop
/// the unmanaged table on every diff. Reads + writes still go through
/// raw SQL in otp-store.ts (panel-locked — login path is too perf-
/// sensitive to round-trip through Prisma's transaction layer).
///
/// Compound PK (phone, issuedAt) matches the raw-SQL shape exactly.
///
/// @derives(ADR-0007) — phone-OTP login
/// @derives(panel-2026-05-08) — leave OTP read/write in raw SQL; schema
///   only mirrors the table shape so migrations stay clean
model OtpAttempt {
  /// @personal phone (E.164)
  phone     String   @db.VarChar(16)
  codeHash  String   @map("code_hash")
  issuedAt  DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  consumed  Boolean  @default(false)

  @@id([phone, issuedAt])
  @@index([phone, issuedAt(sort: Desc)], map: "otp_phone_recent_idx")
  @@map("otp_attempts")
  @@schema("axhy")
}

/// Registered phone with a 10-state DeviceState machine (UNREGISTERED →
/// REGISTERED → TRUSTED → REVOKED ...). Per data-flow §4 + §5 — used for
/// per-device session tracking, login rate-limiting, revocation.
///
/// One row per (user, company, phone). A user with two phones in one
/// company has two Device rows; a supervisor with memberships in two
/// companies has two Device rows even with the same phone.
///
/// @derives(panel-2026-05-08) — phase B.1 foundation lock
model Device {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @db.Uuid
  userId     String    @db.Uuid
  /// 10-state DeviceState machine (default REGISTERED on first OTP login;
  /// progresses to TRUSTED after explicit founder/HR approval).
  state      String    @default("REGISTERED")
  /// @personal phone model (e.g. "iPhone 14", "Redmi Note 12")
  phoneModel String?
  /// @personal OS version
  osVersion  String?
  /// @personal app version (vX.Y.Z) — for forced-upgrade flow
  appVersion String?
  /// @personal last time the device made an authenticated request
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([companyId, state])
  @@schema("axhy")
}

// ============================================================================
// Domain (Phase B.2) — supervisor / HR action targets
// ============================================================================

/// Daily attendance fact: one row per (worker × date) with a status
/// (PRESENT, ABSENT_NO_CALL, ABSENT_APPROVED_LEAVE, HALF_DAY, ON_BREAK).
/// Written by supervisor's "Mark worker absent" action (B.3) and by the
/// auto-clock-in flow when a Visit transitions STARTED. Used by the
/// payroll computation pipeline (B.6 outbox topic `payroll.recompute`).
///
/// @derives(data-flow §5 — supervisor "Mark worker absent" action)
/// @derives(panel-2026-05-08) — Phase B.2 domain table
model Attendance {
  id                   String   @id @default(uuid()) @db.Uuid
  companyId            String   @db.Uuid
  workerId             String   @db.Uuid
  date                 DateTime @db.Date
  /// PRESENT | ABSENT_NO_CALL | ABSENT_APPROVED_LEAVE | HALF_DAY | ON_BREAK
  status               String
  /// UUID of the supervisor who marked. Not a FK — actor may be deleted
  /// while the attendance fact must persist (DPDP archive).
  markedBySupervisorId String   @db.Uuid
  /// optional free-text reason from supervisor / voice transcription
  reason               String?
  /// pay deduction in paise (0 for PRESENT; e.g. 50000 = ₹500 for full
  /// absence). Computed by payroll worker, may be 0 here on initial
  /// insert and updated later.
  payDeductPaise       Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, date])
  @@index([companyId])
  @@index([companyId, date])
  @@index([companyId, status])
  @@schema("axhy")
}

/// Site-level complaint logged by supervisor. NOTE-tier decision per
/// data-flow §5. If a site has 3+ open complaints in 24h, dispatcher
/// fires `hr.complaint_persisted` outbox topic and SiteState transitions
/// to FLAGGED.
///
/// @derives(data-flow §5 — log site complaint NOTE tier)
/// @derives(panel-2026-05-08) — Phase B.2 domain table
model Complaint {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  siteId       String    @db.Uuid
  /// UUID of supervisor who logged the complaint
  supervisorId String    @db.Uuid
  /// short complaint text — supervisor's words via voice or button flow
  text         String
  /// LOW | MEDIUM | HIGH (NOTE-tier severity)
  severity     String    @default("LOW")
  /// nullable until the complaint is dismissed / resolved by HR/owner
  resolvedAt   DateTime?
  /// UUID of resolver (HR / owner / supervisor)
  resolvedBy   String?   @db.Uuid
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, siteId])
  @@index([companyId, resolvedAt])
  @@schema("axhy")
}

/// Worker swap request — supervisor wants to move workerA off siteA in
/// favor of workerB at siteB (or reassign within the same site).
/// 12-state SwapRequestState machine: DRAFT → SENT → ACCEPTED |
/// DECLINED | EXPIRED → APPLIED | REVERSED.
///
/// OPERATIONAL-tier decision (no typed-words ack required).
///
/// @derives(data-flow §5 — swap worker OPERATIONAL tier)
/// @derives(panel-2026-05-08) — Phase B.2 domain table
model SwapRequest {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  /// UUID of supervisor who initiated the swap
  supervisorId String    @db.Uuid
  fromWorkerId String    @db.Uuid
  toWorkerId   String    @db.Uuid
  siteId       String    @db.Uuid
  /// 12-state SwapRequestState
  state        String    @default("DRAFT")
  /// when the swap takes effect
  effectiveAt  DateTime
  /// reason supervisor gave
  reason       String?
  /// nullable until accepted/declined by both workers (or the system)
  decidedAt    DateTime?
  appliedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromWorker Worker  @relation("SwapFromWorker", fields: [fromWorkerId], references: [id], onDelete: Cascade)
  toWorker   Worker  @relation("SwapToWorker", fields: [toWorkerId], references: [id], onDelete: Cascade)
  site       Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, state])
  @@index([siteId, effectiveAt])
  @@schema("axhy")
}

/// Supervisor decision proposed by AI chat (Phase C) before being
/// applied. Phase B Tier 1 routes write directly to the domain table
/// (Attendance, LeaveRequest, etc.) + AuditEvent without going through
/// SupervisorDecision. This table exists so the connectedness map can
/// see the planned Phase C entity, and so AI-extracted proposals have
/// a stable home when chat ships.
///
/// Decision tiers per data-flow §5:
///   - NOTE: auto-stored quietly, no UX
///   - OPERATIONAL: informational, supervisor confirms in passing
///   - PERSONNEL: warm/important, single-tap confirm
///   - EMPLOYMENT: danger/irreversible, typed-words ack required
///
/// @derives(data-flow §5 — supervisor decision tiers)
/// @derives(panel-2026-05-08) — Phase B.2 placeholder for Phase C AI
model SupervisorDecision {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  supervisorId String    @db.Uuid
  /// MARK_ABSENT | APPROVE_LEAVE | LOG_COMPLAINT | SWAP_WORKER | ...
  kind         String
  /// NOTE | OPERATIONAL | PERSONNEL | EMPLOYMENT
  tier         String
  /// flexible target — worker / site / swap / leave_request / visit
  targetId     String?
  /// AI-extracted reasoning + entity refs + confidence
  payload      Json      @default("{}")
  /// nullable until supervisor confirms (or rejects)
  appliedAt    DateTime?
  /// EMPLOYMENT-tier requires explicit typed-words acknowledgment
  ackRequired  Boolean   @default(false)
  ackedAt      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, supervisorId, createdAt])
  @@index([companyId, tier])
  @@index([companyId, appliedAt])
  @@schema("axhy")
}

/// Supervisor's daily living-doc snapshot — personal rules, today's
/// worker status, today's sites, prior-day context. Loaded fresh at
/// 3:30 AM by the daily-prep worker (B.6+) and cached for the day's
/// Per-supervisor "living context" — the moat. Loaded into chat prompt as
/// Tier 2 cache slot; bumped on every confirmed propose_living_doc_update.
///
/// Renamed from `SupervisorDailyContext` in Wave 4b Phase 2 (2026-05-11) per
/// Spec 2 §3.5. Five JSON sections, each an array of LivingDocRule with
/// state ('PENDING'|'ACTIVE'|'REJECTED'|'EXPIRED'); only ACTIVE filtered
/// into prompt context this wave. PENDING/REJECTED used by Phase D nightly
/// nano-tier extractor.
///
/// @derives(spec-2 §3.5 — LivingDoc shape)
/// @derives(spec-2 §6 — extraction paths)
/// @derives(data-flow §8 — supervisor.context_load AI surface)
model LivingDoc {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @db.Uuid
  supervisorId      String    @db.Uuid
  /// JSON arrays of LivingDocRule per Spec 2 §3.5. Each rule:
  ///   { id, ruleText, description, visibility, scope, createdAt,
  ///     createdBy, state, decidedAt?, confidence?, source }
  /// Only state='ACTIVE' filtered into prompt context this wave.
  /// @derives(spec-2 §3.5)
  siteRules         Json      @default("[]")
  workerNotes       Json      @default("[]")
  clientPreferences Json      @default("[]")
  recurringTasks    Json      @default("[]")
  freeNotes         Json      @default("[]")
  /// Bumped on every successful propose_living_doc_update apply. Used as
  /// part of OpenAI prompt_cache_key so cache busts when rules change.
  /// @derives(spec-2 §8.2)
  version           Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, supervisorId])
  @@schema("axhy")
}

/// HR Update — HR creates these to push instructions to supervisors
/// (e.g. "new policy effective Monday, ack required"). Supervisor must
/// type a stable acknowledgment phrase to clear it. Per data-flow §5
/// (PERSONNEL/EMPLOYMENT tier — typed-words ack required).
///
/// @derives(data-flow §5 — HR update + typed-words ack)
/// @derives(panel-2026-05-08) — Phase B.2 placeholder for HR routes
model HRUpdate {
  id                     String    @id @default(uuid()) @db.Uuid
  companyId              String    @db.Uuid
  /// UUID of HR user who created the update
  hrId                   String    @db.Uuid
  /// POLICY_CHANGE | URGENT_NOTICE | PAYROLL_REMINDER | ...
  kind                   String
  /// the message body (rendered to supervisor as-is)
  content                String
  /// nullable for org-wide updates; UUID of specific supervisor when
  /// targeted
  targetSupervisorId     String?   @db.Uuid
  /// require explicit typed-words ack before clearing
  acknowledgmentRequired Boolean   @default(false)
  /// the exact phrase the supervisor must type (matched case-
  /// insensitive). Defaults to "I understand" if ack required.
  acknowledgmentPhrase   String?
  /// UUID of supervisor who acknowledged (only one per HRUpdate per
  /// supervisor; this captures most-recent ack)
  acknowledgedBy         String?   @db.Uuid
  acknowledgedAt         DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, targetSupervisorId])
  @@index([companyId, acknowledgedAt])
  @@schema("axhy")
}

/// Photo evidence per Visit. Each row tracks one R2 path + side
/// metadata (BEFORE/AFTER) + AI verification status. Visit.photosBefore
/// + Visit.photosAfter are denormalized counts for fast supervisor
/// reads; this table holds the row-level detail.
///
/// @derives(data-flow §5 — worker capture photos)
/// @derives(panel-2026-05-08) — Phase B.2 placeholder for photo upload
///   flow (real upload routes ship in B.5+)
model VisitPhoto {
  id             String   @id @default(uuid()) @db.Uuid
  companyId      String   @db.Uuid
  visitId        String   @db.Uuid
  /// BEFORE | AFTER
  side           String
  /// R2 object key (path within bucket, NOT full URL)
  r2Key          String
  /// optional perceptual hash for duplicate-photo detection
  pHash          String?
  /// AI verification status: PENDING | PASS | FLAGGED | NEEDS_REVIEW
  aiVerifyStatus String   @default("PENDING")
  /// short verification reasoning text from AI (1-2KB)
  aiVerifyText   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  visit   Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([visitId])
  @@index([companyId, aiVerifyStatus])
  @@schema("axhy")
}
