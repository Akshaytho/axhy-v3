// packages/shared-schema/prisma/schema.prisma
//
// Axhy v3 Prisma schema — single source of truth for the database.
//
// @derives(ADR-0003) — Single source of truth for schema
// @derives(ADR-0004) — Postgres on Railway
// @derives(panel-2026-05-08 — Phase B.1 foundation: AuditEvent + Outbox + Device)
//
// Day 3 scope: Company, User, Membership + Site, Worker, Visit, LeaveRequest.
// Phase B.1: AuditEvent (system-of-record audit trail), Outbox (atomic
// side-effect queue), Device (registered phone with TRUSTED state).
// Remaining domain tables (Attendance, SupervisorDecision,
// SupervisorDailyContext, HRUpdate, SwapRequest, VisitPhoto) land in B.2.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["axhy"]
}

// ============================================================================
// Tenant
// ============================================================================

model Company {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  slug       String   @unique
  /// @personal owner contact phone (E.164)
  ownerPhone String   @db.VarChar(16)
  /// @personal owner contact name
  ownerName  String
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  memberships Membership[]
  users       User[]
  sites       Site[]
  workers     Worker[]
  visits      Visit[]
  leaves      LeaveRequest[]
  auditEvents AuditEvent[]
  outbox      Outbox[]
  devices     Device[]

  @@schema("axhy")
}

// ============================================================================
// Identity (cross-company)
// ============================================================================

model User {
  id        String   @id @default(uuid()) @db.Uuid
  /// @personal phone is the primary login; E.164 format
  phone     String   @unique @db.VarChar(16)
  /// @personal full legal name
  name      String?
  /// @personal preferred locale
  locale    String   @default("en") @db.VarChar(8)
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  Company     Company?     @relation(fields: [companyId], references: [id])
  companyId   String?      @db.Uuid

  workerProfile Worker?
  devices       Device[]

  @@index([companyId])
  @@schema("axhy")
}

model Membership {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  userId    String   @db.Uuid
  role      String
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId, role])
  @@index([companyId])
  @@index([userId])
  @@schema("axhy")
}

// ============================================================================
// Operational
// ============================================================================

model Site {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  name      String
  /// @personal optional site address
  address   String?
  /// nullable if site is not yet geocoded
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  /// 14-state SiteState machine (placeholder string until state-machines wires it)
  state     String   @default("DRAFT")
  /// per-site weekly day-pattern override (default = 6-day week)
  workdays  String   @default("MTWTFS") @db.VarChar(7)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  visits  Visit[]

  @@index([companyId])
  @@index([companyId, state])
  @@schema("axhy")
}

model Worker {
  id              String   @id @default(uuid()) @db.Uuid
  companyId       String   @db.Uuid
  /// optional User link — workers may exist before they get phone access
  userId          String?  @unique @db.Uuid
  /// @personal worker name as displayed
  name            String
  /// @personal worker phone (E.164)
  phone           String   @db.VarChar(16)
  /// @personal optional worker bank for salary
  bankIfsc        String?  @db.VarChar(16)
  /// @personal optional worker bank account
  bankAcct        String?
  /// 15-state WorkerState machine (see @axhy/state-machines)
  state           String   @default("INVITED")
  /// monthly salary in paise (₹1 = 100 paise)
  baseSalaryPaise Int      @default(0)
  joinedAt        DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?          @relation(fields: [userId], references: [id])
  visits  Visit[]
  leaves  LeaveRequest[]

  @@unique([companyId, phone])
  @@index([companyId])
  @@index([companyId, state])
  @@schema("axhy")
}

model Visit {
  id                String    @id @default(uuid()) @db.Uuid
  companyId         String    @db.Uuid
  workerId          String    @db.Uuid
  siteId            String    @db.Uuid
  /// 12-state VisitState v1.1 machine
  state             String    @default("SCHEDULED")
  scheduledFor      DateTime
  startedAt         DateTime?
  completedAt       DateTime?
  /// 0-16; soft cap on photo count per master plan §G
  photosBefore      Int       @default(0)
  photosAfter       Int       @default(0)
  /// optional voice note ref (S3/R2 key); voice file deleted within 24h after STT
  voiceKey          String?
  /// AI verification text (1-2KB, stored after AI verification surface fires)
  verificationText  String?
  /// AI verification model used (per ADR-0023)
  verificationModel String?
  /// flagged-for-supervisor-review bit
  flagged           Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)
  site    Site    @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([companyId, scheduledFor])
  @@index([companyId, state])
  @@index([workerId, scheduledFor])
  @@index([siteId, scheduledFor])
  @@index([companyId, flagged], map: "visit_flagged_idx")
  @@schema("axhy")
}

model LeaveRequest {
  id           String    @id @default(uuid()) @db.Uuid
  companyId    String    @db.Uuid
  workerId     String    @db.Uuid
  fromDate     DateTime  @db.Date
  toDate       DateTime  @db.Date
  reason       String
  /// 12-state LeaveRequestState machine (placeholder)
  state        String    @default("REQUESTED")
  decidedBy    String?   @db.Uuid
  decidedAt    DateTime?
  /// @personal optional supervisor note
  decisionNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  worker  Worker  @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([companyId, state])
  @@index([workerId])
  @@index([companyId, fromDate])
  @@schema("axhy")
}

// ============================================================================
// Foundation (Phase B.1) — audit trail, side-effect queue, device registry
// ============================================================================

/// System-of-record audit. Every state transition + supervisor/HR decision
/// writes one immutable row here. Per data-flow §4 — this is the source of
/// truth the panel + the connectedness map's audit-event nodes mirror.
///
/// @derives(master-plan §L) — bug-prevention discipline (every transition
/// auditable)
/// @derives(panel-2026-05-08) — phase B.1 foundation lock
model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  /// stable kind string from a known taxonomy (WORKER_MARKED_ABSENT,
  /// LEAVE_APPROVED, SITE_COMPLAINT_LOGGED, ...). Not an enum so the
  /// taxonomy can grow without schema migrations.
  kind      String
  /// UUID of the user who took the action (supervisor / HR / owner /
  /// system). Not a FK — actor may be deleted while audit must persist.
  actorId   String   @db.Uuid
  /// flexible target ref (worker / site / swap / visit / leave_request).
  /// String not Uuid because some targets are composite or string keys.
  targetId  String?
  /// structured payload — diff, prior-state, decision-tier, anything the
  /// row's `kind` taxonomy specifies. JSON for forward-compat.
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, kind])
  @@index([companyId, createdAt])
  @@index([actorId])
  @@schema("axhy")
}

/// Atomic side-effect queue. Every domain write that triggers an external
/// effect (Gupshup SMS, payroll recompute, AI verification, email)
/// enqueues one row here inside the same transaction as the domain write.
/// A separate dispatcher process (Phase B.6) drains this with retry +
/// exponential backoff. Per data-flow §4 — outbox pattern, atomic.
///
/// @derives(master-plan §L) — cascade depth ≤ 3 enforced in dispatcher
/// @derives(ADR-0009) — outbox over Redis until measured pain
/// @derives(panel-2026-05-08) — phase B.1 foundation lock
model Outbox {
  id          String    @id @default(uuid()) @db.Uuid
  companyId   String    @db.Uuid
  /// dotted topic name (gupshup.send, payroll.recompute, ai.verify, ...)
  topic       String
  /// payload the dispatcher hands to the topic's handler
  payload     Json      @default("{}")
  /// nullable until processed. Idempotent re-tries only run when
  /// processedAt is null AND nextRetryAt is in the past.
  processedAt DateTime?
  /// retry counter; >= 5 → quarantined (handler stops retrying)
  failCount   Int       @default(0)
  /// next time the dispatcher should attempt this row (for backoff)
  nextRetryAt DateTime  @default(now())
  /// last error message, for ops triage
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([processedAt, nextRetryAt])
  @@index([topic])
  @@schema("axhy")
}

/// OTP attempts table — backs the OTP-login flow. Schema mirrors the raw
/// SQL table created in `apps/backend/src/lib/otp-store.ts::ensureSchema`.
/// Modeled in Prisma SOLELY so the schema-driven migration doesn't drop
/// the unmanaged table on every diff. Reads + writes still go through
/// raw SQL in otp-store.ts (panel-locked — login path is too perf-
/// sensitive to round-trip through Prisma's transaction layer).
///
/// Compound PK (phone, issuedAt) matches the raw-SQL shape exactly.
///
/// @derives(ADR-0007) — phone-OTP login
/// @derives(panel-2026-05-08) — leave OTP read/write in raw SQL; schema
///   only mirrors the table shape so migrations stay clean
model OtpAttempt {
  /// @personal phone (E.164)
  phone     String   @db.VarChar(16)
  codeHash  String   @map("code_hash")
  issuedAt  DateTime @default(now()) @db.Timestamptz(6) @map("issued_at")
  expiresAt DateTime @db.Timestamptz(6) @map("expires_at")
  consumed  Boolean  @default(false)

  @@id([phone, issuedAt])
  @@index([phone, issuedAt(sort: Desc)], map: "otp_phone_recent_idx")
  @@map("otp_attempts")
  @@schema("axhy")
}

/// Registered phone with a 10-state DeviceState machine (UNREGISTERED →
/// REGISTERED → TRUSTED → REVOKED ...). Per data-flow §4 + §5 — used for
/// per-device session tracking, login rate-limiting, revocation.
///
/// One row per (user, company, phone). A user with two phones in one
/// company has two Device rows; a supervisor with memberships in two
/// companies has two Device rows even with the same phone.
///
/// @derives(panel-2026-05-08) — phase B.1 foundation lock
model Device {
  id         String    @id @default(uuid()) @db.Uuid
  companyId  String    @db.Uuid
  userId     String    @db.Uuid
  /// 10-state DeviceState machine (default REGISTERED on first OTP login;
  /// progresses to TRUSTED after explicit founder/HR approval).
  state      String    @default("REGISTERED")
  /// @personal phone model (e.g. "iPhone 14", "Redmi Note 12")
  phoneModel String?
  /// @personal OS version
  osVersion  String?
  /// @personal app version (vX.Y.Z) — for forced-upgrade flow
  appVersion String?
  /// @personal last time the device made an authenticated request
  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([companyId, state])
  @@schema("axhy")
}
